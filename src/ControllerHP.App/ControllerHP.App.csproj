<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tray app on Avalonia, replacing the WinForms one (src/ControllerHP) stage by stage. It builds on
    ControllerHP.Core for everything that isn't interface.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows for now; Avalonia itself runs on macOS and Linux too. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ControllerHP</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\ControllerHP\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tray's "no devices" icon. -->
    <EmbeddedResource Include="..\ControllerHP\app.ico" LogicalName="ControllerHP.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControllerHP.Core\ControllerHP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <PropertyGroup>
    <Version>0.3.0</Version>
    <Product>ControllerHP</Product>
    <Title>ControllerHP</Title>
    <Description>Battery meter for game controllers and other devices, in the Windows taskbar.</Description>
    <Authors>rcheong</Authors>
    <Copyright>Copyright © 2026 rcheong</Copyright>
  </PropertyGroup>

</Project>
